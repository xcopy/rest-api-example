APP_NAME="REST API Example"
APP_ENV=local

AUTH_ACCESS_TOKEN_TTL="+30 minutes"
AUTH_REFRESH_TOKEN_TTL="+30 days"

CORS_ALLOWED_ORIGINS="http://localhost:8000"
CORS_ALLOWED_METHODS="GET, POST, PUT, PATCH, DELETE"
CORS_ALLOWED_HEADERS="Authorization, Content-Type"
CORS_MAX_AGE=600
CORS_EXPOSED_HEADERS="RateLimit-Limit, RateLimit-Remaining, RateLimit-Reset, Retry-After, X-Pagination-Total-Count, X-Pagination-Total-Pages, X-Pagination-Current-Page, X-Pagination-Per-Page"

MYSQL_DATABASE=rest_api_example
MYSQL_HOSTNAME=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_CHARSET=utf8mb4

RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW=60

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TIMEOUT=1
REDIS_DATABASE=0
REDIS_PREFIX=rest-api-example:
REDIS_USERNAME=
REDIS_PASSWORD=