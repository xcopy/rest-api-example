{
    "name": "xcopy/rest-api-example",
    "type": "project",
    "authors": [
        {
            "name": "Kairat Jenishev",
            "email": "kairat.jenishev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laminas/laminas-db": "^2.22",
        "leafs/form": "^5.0.1",
        "middlewares/trailing-slash": "^2.1",
        "monolog/monolog": "^3.12.1",
        "php-di/php-di": "^7.1.1",
        "predis/predis": "^3.7",
        "robmorgan/phinx": "^0.16.12",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15.3",
        "symfony/mailer": "^7.4.19",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "fakerphp/faker": "^1.24.1",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "pestphp/pest": "^4.7.8",
        "phpstan/phpstan": "^2.3.1",
        "psy/psysh": "^0.12.24",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": [
            "vendor/bin/phpstan analyse --error-format=table --no-progress"
        ],
        "db:fresh": [
            "vendor/bin/phinx rollback -t 0 -c .phinx.php",
            "vendor/bin/phinx migrate -c .phinx.php"
        ],
        "db:seed": [
            "vendor/bin/phinx seed:run -c .phinx.php -s UserSeeder -s RoleSeeder -s PermissionSeeder -s PermissionRoleSeeder -s RoleUserSeeder"
        ],
        "fix": [
            "vendor/bin/php-cs-fixer fix"
        ],
        "test": "vendor/bin/pest",
        "test:db": [
            "@putenv APP_ENV=testing",
            "vendor/bin/phinx rollback -t 0 -c .phinx.php",
            "vendor/bin/phinx migrate -c .phinx.php",
            "vendor/bin/phinx seed:run -c .phinx.php -s RoleSeeder -s PermissionSeeder -s PermissionRoleSeeder"
        ]
    }
}
