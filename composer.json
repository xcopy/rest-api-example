{
    "name": "xcopy/rest-api-example",
    "type": "project",
    "authors": [
        {
            "name": "Kairat Jenishev",
            "email": "kairat.jenishev@gmail.com"
        }
    ],
    "autoload": {
        "files": ["app/helpers.php"],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require": {
        "php": "^8.0",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "robmorgan/phinx": "^0.16.12",
        "laminas/laminas-db": "^2.22",
        "php-di/php-di": "^7.1",
        "fzaninotto/faker": "^1.5",
        "beberlei/assert": "^3.3",
        "middlewares/trailing-slash": "^2.1",
        "leafs/form": "^5.0",
        "vlucas/phpdotenv": "^5.7",
        "predis/predis": "^3.6",
        "monolog/monolog": "^3.12",
        "symfony/mailer": "^7.1"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.4",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "psy/psysh": "^0.12.24"
    },
    "scripts": {
        "db:fresh": [
            "vendor/bin/phinx rollback -t 0 -c .phinx.php",
            "vendor/bin/phinx migrate -c .phinx.php"
        ],
        "db:seed": [
            "vendor/bin/phinx seed:run -c .phinx.php -s UserSeeder -s RoleSeeder -s PermissionSeeder -s PermissionRoleSeeder -s RoleUserSeeder"
        ],
        "fix": [
            "vendor/bin/php-cs-fixer fix"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --error-format=table --no-progress > .phpstan-report.txt || true"
        ]
    }
}
